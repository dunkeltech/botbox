{
	admin off
	auto_https off
}

:8000 {
	handle /api/* {
		reverse_proxy {$BOTBOX_API_UPSTREAM:127.0.0.1:8080}
	}

	handle /ws/* {
		reverse_proxy {$BOTBOX_API_UPSTREAM:127.0.0.1:8080}
	}

	handle {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		reverse_proxy {$BOTBOX_FRONTEND_UPSTREAM:127.0.0.1:3000}
	}
}
