# Local development defaults for bot.Box.
# Copy to .env for overrides. Never commit real secrets.

DATABASE_URL=postgres://botbox:botbox@127.0.0.1:5432/botbox?sslmode=disable
NATS_URL=nats://127.0.0.1:4222

API_LISTEN_ADDR=127.0.0.1:8080
AGENT_GRPC_ADDR=127.0.0.1:9090
EGRESS_PROXY_ADDR=127.0.0.1:8081

FRONTEND_URL=http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000

JWT_PRIVATE_KEY_PATH=.devenv/state/jwt-ed25519.pem
MASTER_KEY_PATH=.devenv/state/master.key
